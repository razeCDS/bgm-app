# Raiz do repositorio. O app tem o proprio .gitignore (web/.gitignore),
# que cobre node_modules, build do Next e o .env.local.

# Segredos: nenhum .env entra no repositorio, em pasta nenhuma.
.env*

# Arquivos temporarios do Supabase CLI, caso seja usado a partir da raiz.
supabase/.temp/
supabase/.branches/

# Sistema operacional e editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Configuracao pessoal do Claude Code (a compartilhada fica em .claude/settings.json)
.claude/settings.local.json
